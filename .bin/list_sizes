#!/bin/dash

# Colors
RED='\033[0;31m'
GREEN_BOLD='\033[1;32m'
BLUE_BOLD='\033[1;36m'
NC='\033[0;39m'

# Default to current directory if no argument
DIR="${1:-.}"

print_sizes() {
  if [ "$#" -gt 0 ]; then
    du -sch "$@" 2>/dev/null | sed 's|^\([^[:space:]]*[[:space:]]*\).*/|\1|'
  else
    printf '%b\n' "${RED}No files found${NC}"
  fi
}

printf '%b\n' "${GREEN_BOLD}Regular files and folders:${NC}"

set --
for item in "$DIR"/*; do
  [ -e "$item" ] || continue
  set -- "$@" "$item"
done

if [ "$#" -gt 0 ]; then
  print_sizes "$@"
else
  printf '%b\n' "${RED}No regular files found${NC}"
fi

printf '\n%b\n' "${GREEN_BOLD}Hidden files and folders:${NC}"

set --
for item in "$DIR"/.[!.]* "$DIR"/..?*; do
  [ -e "$item" ] || continue
  set -- "$@" "$item"
done

if [ "$#" -gt 0 ]; then
  print_sizes "$@"
else
  printf '%b\n' "${RED}No hidden files found${NC}"
fi
